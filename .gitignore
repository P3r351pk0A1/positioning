# .gitignore для Python проекта

# Сборочные артефакты
/build/
/bin/
/out/
/dist/
/data/
/site/
/cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
*.egg-info/

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
env/

# Компилируемые файлы и старые C++ артефакты
*.o
*.obj
*.lo
*.so
*.a
*.lib
*.dll
*.exe
*.out
*.app

# Логи и временные файлы
*.log
*.tmp
*.temp
*.swp
*~

# IDE / редакторы
.vscode/
.vs/
.idea/
*.sln
*.vcxproj*
*.user
*.suo

# ОС
.DS_Store
Thumbs.db
desktop.ini

# Локально собранные программы старого C++ прототипа
positioning.exe
validator.exe
validator_using_main.exe

# Покрытие/отчёты
coverage/
*.gcda
*.gcno
*.gcov
